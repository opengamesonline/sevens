{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node",
      "react"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@opengamesonline/sevens": [
        "../library/src/index.ts"
      ],
      "@opengamesonline/expo-lan-sockets": [
        "../submodules/expo-lan/expo-lan-sockets/src/index.ts"
      ],
      "@opengamesonline/expo-lan-multiplayer": [
        "../submodules/expo-lan/expo-lan-multiplayer/src/index.ts"
      ],
      "expo": [
        "./node_modules/expo"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
